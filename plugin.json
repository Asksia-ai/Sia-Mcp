    "email": "contact@asksia.ai",
    "url": "https://www.asksia.ai"
  },
  "homepage": "https://www.asksia.ai",
  "repository": "https://github.com/Asksia-ai/Sia-Mcp",
  "license": "UNLICENSED",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/getting-started/SKILL.md",
      "interface": {
        "displayName": "AskSia",
